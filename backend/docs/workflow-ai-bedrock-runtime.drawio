        <mxCell id="step-7-desc-legend" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Return API response&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;FlowExecutionResponse goes back through the ALB. Failures use the existing API error contract.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="step-7-legend">
          <mxGeometry height="70" width="548" x="52" as="geometry" />
        </mxCell>
        <mxCell id="legend-iam-note" style="text;html=1;align=left;verticalAlign=top;fontSize=13;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;IAM and observability.&lt;/b&gt; ECS task role: bedrock:InvokeModel on the configured model ARN, plus CloudWatch logs. No Lambda role. CloudWatch collects metrics and sanitized logs only. No prompt payloads in logs.&lt;/span&gt;" vertex="1" parent="legend-container">
          <mxGeometry x="0" y="600" width="600" height="80" as="geometry" />
        </mxCell>
